# ------------------------------------------------------------------
# Samvidhan AI settings. setup.bat copies this file to ".env".
# Edit ".env" (not this file), save it, then restart the app.
# ------------------------------------------------------------------

# Who writes the answers:
#   auto        = API key if one is set below, otherwise Claude Code on this PC (default)
#   claude_code = Claude Code from the VS Code extension, using your Claude subscription
#                 (no API key, no charge per question; your plan's usage limits apply)
#   api         = the paid Claude API (needs ANTHROPIC_API_KEY)
#   off         = search-only, no AI answers
ANSWER_ENGINE=auto

# Optional: which model Claude Code uses (empty = Claude Code's default, e.g. claude-opus-5-5)
CLAUDE_CODE_MODEL=
# The quick helper model for small jobs (translating questions, reading hard scans): haiku, sonnet or opus
CLAUDE_CODE_FAST_MODEL=haiku

# Optional: where your cases, files and calendar are kept (default: the "workspace" folder here)
# WORKSPACE_DIR=D:\lawyers-ai\workspace

# Your Claude API key, from https://platform.claude.com -> API Keys.
# Only needed for ANSWER_ENGINE=api (or auto, if you want the API instead of Claude Code).
ANTHROPIC_API_KEY=

# Which Claude model writes the answers (approximate cost per question):
#   claude-opus-5-5    best quality      ~$0.05  (about Rs 4)
#   claude-sonnet-5-5  good, cheaper     ~$0.025 (about Rs 2)
#   claude-haiku-5-5   cheapest          ~$0.001 (about Rs 0.10)
CLAUDE_MODEL=claude-opus-5-5

# How hard Claude thinks before answering: low, medium or high.
# Higher = more careful but slower and more expensive.
CLAUDE_EFFORT=medium

# Used only to show costs in rupees.
USD_TO_INR=88
